# ---- AI Answer Verification backend ----
# Copy to .env and fill in. NEVER commit .env. These values stay on the server.

# OpenRouter (required for Smart Verification). The default model must accept images for screenshots/scanned PDFs.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Comma-separated list shown in the UI. Check https://openrouter.ai/models for current IDs.
OPENROUTER_MODELS=openai/gpt-4o-mini,openai/gpt-4o,anthropic/claude-3.5-haiku,google/gemma-3-27b-it
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=1
OPENROUTER_APP_URL=http://localhost:5173

# Supabase (leave blank to use local JSON storage with authentication disabled)
# The anon key is used server-side together with each user's JWT, so RLS policies apply.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_DATA_DIR=data
